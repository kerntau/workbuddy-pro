[Unit]
Description=Workbuddy Pro (CodeBuddy 账号池管理控制台 · OpenAI 兼容网关)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/workbuddy-manager
# 统计日界使用的时区。用量按本地日累计，宿主机若是 UTC（云服务器默认），
# 北京时间 00:00–08:00 会仍算前一天。下面的 EnvironmentFile 可覆盖本行。
Environment=TZ=Asia/Shanghai
# 以专用账号运行（install.sh 创建，uid 10001 与容器形态对齐，便于共享上游
# 的 auths/ 与 config.json 写权限）。管理端是攻击面最大的常驻进程，不能以
# root 跑：任何文件写类漏洞都会直达宿主最高权限。
User=workbuddy
Group=workbuddy
# 上游以容器形态部署时，「重载上游 / 读上游日志 / 一键更新」需要访问
# docker.sock（install.sh 会把服务账号加入 docker 组）。
# 注意：docker 组等同宿主 root。若上游是 native 进程（WB2API_MODE=native），
# 删掉下面这行可以去掉这个等价 root 的通道。
SupplementaryGroups=docker
Environment=WB_MANAGER_HOST=0.0.0.0
Environment=WB_MANAGER_PORT=7864
Environment=WB2API_BASE=http://127.0.0.1:7863
Environment=WB2API_CONTAINER=workbuddy2api
Environment=WB_AUTH_DIR=/opt/workbuddy2api/auths
Environment=WB_UPSTREAM_CONFIG=/opt/workbuddy2api/config.json
Environment=WB_DATA_DIR=/opt/workbuddy-manager/data
Environment=WB_STATIC_DIR=/opt/workbuddy-manager/web/out
Environment=WB_SECURE_COOKIE=auto
# 真实 IP 取自反代覆盖写入的 X-Real-IP；前置 CDN 时把跳数改成 CDN+反代层数
Environment=WB_TRUST_PROXY=1
Environment=WB_TRUSTED_PROXY_HOPS=1
# 生产环境不暴露 /docs、/openapi.json（需要调试时改为 1）
Environment=WB_ENABLE_DOCS=0
# 每密钥每分钟调用上限（0 = 不限）
Environment=WB_GATEWAY_RATE_PER_MIN=120
# 首次启动若不设 WB_ADMIN_PASSWORD，会随机生成并打印到日志（journalctl 可见）
# Environment=WB_ADMIN_PASSWORD=改成你的强密码
#
# 上面这些之外的可选项（出口代理 WB_HTTP_PROXY、更新代理 WB_UPDATE_PROXY、
# 新账号默认线路 WB_DEFAULT_ACCOUNT_PROXY…）写进安装目录的 .env 就行 —— 由下面
# 这行读进来。`-` 表示文件不存在时不报错（老部署没有该文件也能启动）。
# 注意：EnvironmentFile 的值是**字面量**，别在值后面写行内注释。
EnvironmentFile=-/opt/workbuddy-manager/.env

# 本项目的一键部署默认直连访问：绑定全网卡，由云平台安全组与 UFW 收紧来源。
# 走 HTTPS 反向代理时，可把这里与上面的 WB_MANAGER_HOST 改为 127.0.0.1。
ExecStart=/usr/bin/python3 -m uvicorn server.main:app --host 0.0.0.0 --port 7864
Restart=always
RestartSec=3

# ── 沙箱（最小权限）──────────────────────────────────────
# 服务只需要：读写自己的 data/ 与上游目录、连 docker.sock（SupplementaryGroups）。
# NoNewPrivileges：进程树内不能再提权（sudo/su/setuid 全失效）。
# ProtectSystem=full：/usr /boot /etc 只读（应用目录在 /opt，不受影响）。
# ProtectHome：/root /home 不可达。PrivateTmp：独立 /tmp。
# RestrictAddressFamilies：只留 inet/inet6/unix（docker.sock 是 unix 套接字）。
# CapabilityBoundingSet 置空：不携带任何 Linux capability 启动。
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
